# Deployment: backups, database dumps, and TLS private material must never
# be committed. deploy/backups/ is the default location backup.sh writes to
# (outside any web-served directory); Caddy's own certificate/key storage
# lives in Docker named volumes (caddy_data/caddy_config), not the repo tree.
deploy/backups/
*.sql
*.sql.gz
*.dump
*.pgdump
*.tar.gz
*.tar.zst
*.pem
*.key
*.crt
*.p12
*.pfx

