+  gap: var(--space-2);
+}
+
+.drawer-badge {
+  display: inline-flex;
+  align-items: center;
+  padding: 0.1rem 0.55rem;
+  font-size: var(--font-size-xs);
+  font-weight: 700;
+  border-radius: var(--radius-pill);
+}
+
+.drawer-badge--clo {
+  color: var(--color-text-secondary);
+  background: var(--color-surface-muted);
+}
+
+.drawer-badge--topic {
+  color: var(--color-brand-teal-strong);
+  background: var(--color-brand-teal-subtle);
+}
+
+.drawer-finding-list {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-4);
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+
+.drawer-finding-item {
+  padding: var(--space-3);
+  background: var(--color-surface-muted);
+  border-radius: var(--radius-md);
+}
+
+.drawer-finding-item p {
+  margin-block: var(--space-1) 0;
+}
+
+.drawer-finding-header {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  justify-content: space-between;
+  gap: var(--space-2);
+}
+
+.drawer-evidence-disclosure > summary {
+  font-weight: 700;
+  cursor: pointer;
+}
