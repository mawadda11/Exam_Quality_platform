# Production/staging environment template. PLACEHOLDERS ONLY - never real
# secrets. Copy this file to `.env.production` on the deployment host, fill
# in every value marked "replace-with"/"example.com" below, and keep
# `.env.production` out of Git (it already matches the repo's `.env.*`
# .gitignore pattern - do not add a `!` negation for it).
#
# See docs/DEPLOYMENT.md for the full walkthrough, including how to generate
# a strong SECRET_KEY and a strong PostgreSQL password, SMTP requirements,
# and a local smoke-test recipe that reuses this same file with `localhost`
# values instead of a real domain.

# --- Core application -------------------------------------------------
# Must be exactly "production" for staging/production: this activates the
# strong-SECRET_KEY and SMTP-required checks in
# backend/app/core/config.py:validate_runtime_settings, and disables the
# interactive API docs (/docs, /redoc, /openapi.json).
APP_ENV=production
APP_NAME=Exam Quality Analyzer
API_PREFIX=/api/v1

# --- Domain and reverse proxy ------------------------------------------
# CHANGE THESE. APP_DOMAIN is informational/used by scripts; CADDY_SITE_ADDRESS
# is what Caddy (deploy/Caddyfile) actually binds to - it controls whether
# Caddy auto-provisions a real TLS certificate (a real domain) or serves
# plain HTTP (http://localhost, for the local smoke test only - see
# docs/DEPLOYMENT.md section "Local production smoke test").
APP_DOMAIN=example.com
CADDY_SITE_ADDRESS=https://example.com

# --- Secret key ----------------------------------------------------------
# CHANGE THIS. Must be at least 32 random characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# validate_runtime_settings() refuses to start with this placeholder value
# or with fewer than 32 characters when APP_ENV=production/staging.
SECRET_KEY=replace-with-at-least-32-random-characters

# --- PostgreSQL ------------------------------------------------------------
# CHANGE POSTGRES_PASSWORD (and DATABASE_URL's copy of it below - they must
# match). Never reuse the development database's "exam_quality" password.
# See docs/DEPLOYMENT.md section H for password requirements.
POSTGRES_DB=exam_quality
POSTGRES_USER=exam_quality
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgresql+psycopg://exam_quality:replace-with-a-strong-password@postgres:5432/exam_quality

# --- Vector store (ChromaDB) ---------------------------------------------
# "chromadb"/8000 are the internal Compose service name/port - do not change
# these unless docker-compose.prod.yml's chromadb service name changes too.
VECTOR_STORE_PROVIDER=chroma
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# --- CORS and password reset ----------------------------------------------
# CHANGE THESE to the real public domain (or http://localhost for the local
# smoke test). No wildcards - CORS must name the exact origin(s) faculty use.
ALLOWED_ORIGINS=https://example.com
PASSWORD_RESET_URL=https://example.com/reset-password

# --- AI provider: fully local Ollama, no API key required -----------------
# Ollama itself is never a Compose service and is never published on any
# port; it must already be running on the deployment host (see
# docs/DEPLOYMENT.md section D: `ollama pull qwen3.5:4b`, `ollama list`).
# host.docker.internal is how the backend container reaches it - see
# docker-compose.prod.yml's backend.extra_hosts. This is the default and
# recommended production setting - it keeps governed evidence text entirely
# on infrastructure you control.
AI_PROVIDER=ollama
AI_MODEL=qwen3.5:4b
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Optional cloud alternative (only if the deployment's privacy policy
# permits sending minimized governed evidence text to Google - see
# docs/RAG_AND_AI_DESIGN.md's Free Tier privacy/quota warning). To use it
# instead of Ollama: set AI_PROVIDER=gemini, AI_MODEL=gemini-3.6-flash, and
# CHANGE THIS to a real key. Leave blank while AI_PROVIDER=ollama - it is
# passed only to the backend service (docker-compose.prod.yml), never to
# migrate/storage-init, and is never logged.
GEMINI_API_KEY=replace-with-a-private-api-key
AI_VALIDATION_RETRIES=1

# --- Uploads, retention, logging -----------------------------------------
MAX_UPLOAD_MB=50
FILE_RETENTION_DAYS=30
LOG_LEVEL=INFO

# --- SMTP (required outside development) ----------------------------------
# CHANGE ALL OF THESE (left blank here - no safe example mail server exists).
# validate_runtime_settings() refuses to start in production/staging without
# SMTP_HOST and SMTP_FROM_EMAIL - password reset has no debug-token fallback
# outside development. For the *local smoke test only* (never real staging/
# production), docs/DEPLOYMENT.md section 15 shows placeholder SMTP values
# that satisfy this startup check without a working mail server; password
# reset itself will not actually deliver email until these point at a real
# SMTP service. See docs/DEPLOYMENT.md section I.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
