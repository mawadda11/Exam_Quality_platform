APP_ENV=development
APP_NAME=Exam Quality Analyzer
API_PREFIX=/api/v1
SECRET_KEY=replace-with-a-long-random-development-secret
# For running the backend natively (cd backend && ...): Postgres reachable
# at localhost, e.g. via `docker compose up -d postgres` (published on
# 5432) or a native PostgreSQL install with a matching role/database.
# docker-compose.yml overrides this to the "postgres" Compose hostname for
# its own backend container - do not change this line to "postgres".
DATABASE_URL=postgresql+psycopg://exam_quality:exam_quality@localhost:5432/exam_quality
# Native development defaults. Docker Compose overrides these with the
# in-network chromadb hostname/port and selects the real Chroma adapter.
CHROMA_HOST=localhost
CHROMA_PORT=8001
VECTOR_STORE_PROVIDER=memory
# Relative to backend/ (the app's cwd for native runs); docker-compose.yml
# overrides these to the container's absolute /app/... mount paths.
UPLOAD_ROOT=../storage/uploads
EXTRACTED_ROOT=../storage/extracted
REPORT_ROOT=../storage/reports
KB_SOURCE_DIR=../knowledge_base/source
MAX_UPLOAD_MB=50
ALLOWED_ORIGINS=http://localhost:5173
# Provider-neutral exam OCR. Tesseract is the only supported OCR adapter in
# this release and runs locally; native PDF text is still extracted with
# pdfplumber and reconciled against OCR.
EXAM_OCR_PROVIDER=tesseract
EXAM_OCR_FALLBACK_ENABLED=true
# Optional extraction-only structure assistance. This is independent of the
# Question preparation modes are selected in the UI. Manual and structured modes do not
# call extraction Gemini. The extraction-only provider below is independent from the
# governed academic AI_PROVIDER below. It references existing source-line IDs
# and never becomes the transcription source of truth.
EXTRACTION_AI_ENABLED=false
EXTRACTION_AI_PROVIDER=gemini
EXTRACTION_AI_MODEL=gemini-3.6-flash
EXTRACTION_AI_VALIDATION_RETRIES=1
EXTRACTION_AI_PAGE_DPI=144
EXTRACTION_AI_MAX_PAGES_PER_DOCUMENT=25
EXTRACTION_AI_CACHE_ENABLED=true
EXTRACTION_AI_TARGETED_OCR_ENABLED=true
EXTRACTION_AI_CANDIDATE_MIN_CONFIDENCE=0.55
# Safe offline development default: evidence-grounded local baseline, never a live
# external call and never permitted in production. To use Anthropic manually, set
# Post-confirmation semantic analysis uses AI_PROVIDER. It is called only after the exact
# question review revision is confirmed. To use AI_PROVIDER=anthropic, configure an approved exact model ID, and provide
# AI_API_KEY only after the deployment privacy policy permits sending minimized
# document excerpts. Use AI_PROVIDER=fake only for scripted tests.
#
# Optional fully-local Ollama adapter (no API key, nothing leaves the host/
# deployment network): install Ollama, pull an approved model (e.g. `ollama
# pull qwen3.5:4b`), then set AI_PROVIDER=ollama and AI_MODEL=qwen3.5:4b.
# OLLAMA_BASE_URL below is the native-development default (Ollama running on
# this same machine); docker-compose.yml overrides it to
# http://host.docker.internal:11434 so the backend container can reach an
# Ollama server on the host without Ollama being published on any public
# network interface. Leave AI_PROVIDER=local below to keep the safe offline
# default.
#
# Optional Gemini adapter (a cloud provider - only permitted once your
# deployment's privacy policy allows sending minimized governed evidence
# text to Google; see docs/RAG_AND_AI_DESIGN.md): set AI_PROVIDER=gemini,
# AI_MODEL=gemini-3.6-flash, and GEMINI_API_KEY. Never commit a real key -
# this file only ever holds a placeholder.
AI_PROVIDER=local
AI_MODEL=local-governed-baseline-v1
AI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
GEMINI_API_KEY=replace-with-a-private-api-key
AI_VALIDATION_RETRIES=1
AI_FAILOVER_ENABLED=true
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
AI_LOCAL_FALLBACK_MODEL=local-governed-baseline-v1

# Native (non-Docker) runs need the tesseract-ocr system package installed
# separately; the backend Docker image already includes it.
FILE_RETENTION_DAYS=30
LOG_LEVEL=INFO

# Faculty authentication
# Use a random value of at least 32 characters outside local development.
AUTH_ACCESS_TOKEN_MINUTES=720
AUTH_ISSUER=ai-exam-quality-platform
AUTH_AUDIENCE=ai-exam-quality-web
PASSWORD_RESET_TOKEN_MINUTES=30
PASSWORD_RESET_URL=http://localhost:5173/reset-password
# Password reset works without SMTP only in development/test, where the API
# returns a debug reset token. A pilot/staging deployment must configure SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
