APP_ENV=development
APP_NAME=Exam Quality Analyzer
API_PREFIX=/api/v1
SECRET_KEY=replace-with-a-long-random-development-secret
# For running the backend natively (cd backend && ...): Postgres reachable
# at localhost, e.g. via `docker compose up -d postgres` (published on
# 5432) or a native PostgreSQL install with a matching role/database.
# docker-compose.yml overrides this to the "postgres" Compose hostname for
# its own backend container - do not change this line to "postgres".
DATABASE_URL=postgresql+psycopg://exam_quality:exam_quality@localhost:5432/exam_quality
# Native development defaults. Docker Compose overrides these with the
# in-network chromadb hostname/port and selects the real Chroma adapter.
CHROMA_HOST=localhost
CHROMA_PORT=8001
VECTOR_STORE_PROVIDER=memory
# Relative to backend/ (the app's cwd for native runs); docker-compose.yml
# overrides these to the container's absolute /app/... mount paths.
UPLOAD_ROOT=../storage/uploads
EXTRACTED_ROOT=../storage/extracted
REPORT_ROOT=../storage/reports
KB_SOURCE_DIR=../knowledge_base/source
MAX_UPLOAD_MB=50
ALLOWED_ORIGINS=http://localhost:5173
# Safe offline development default: evidence-grounded local baseline, never a live
# external call and never permitted in production. To use Anthropic manually, set
# AI_PROVIDER=anthropic, configure an approved exact model ID, and provide
# AI_API_KEY only after the deployment privacy policy permits sending minimized
# document excerpts. Use AI_PROVIDER=fake only for scripted tests.
AI_PROVIDER=local
AI_MODEL=local-governed-baseline-v1
AI_API_KEY=
AI_VALIDATION_RETRIES=1
# OCR has no env vars of its own: it runs locally via Tesseract (never a
# cloud vendor, so exam content never leaves the server - see
# docs/SECURITY_AND_PRIVACY.md's external-provider rule) and needs no API
# key or provider selection. Native (non-Docker) runs need the tesseract-ocr
# system package installed separately; docker-compose's backend image
# already includes it (see backend/Dockerfile).
FILE_RETENTION_DAYS=30
LOG_LEVEL=INFO

# Faculty authentication
# Use a random value of at least 32 characters outside local development.
AUTH_ACCESS_TOKEN_MINUTES=720
AUTH_ISSUER=ai-exam-quality-platform
AUTH_AUDIENCE=ai-exam-quality-web
PASSWORD_RESET_TOKEN_MINUTES=30
PASSWORD_RESET_URL=http://localhost:5173/reset-password
# Password reset works without SMTP only in development/test, where the API
# returns a debug reset token. A pilot/staging deployment must configure SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
